generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 调试 / 草稿页（原 Page 表迁移而来）
model PageDraft {
  id         Int      @id @default(autoincrement())
  name       String
  schemaJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 线上 / 发布页（Renderer 消费此表）
model PagePublished {
  id            Int      @id @default(autoincrement())
  name          String
  schemaJson    String
  sourceDraftId Int?
  publishedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

/// 用户保存的自定义 SVG 图标库（与 Tabler 预设图标库分离，跨页面复用）
model CustomIcon {
  id         Int      @id @default(autoincrement())
  name       String
  svgContent String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 可编辑文本：以 key 唯一标识一行，不存在时由 PUT 新建
model EditableText {
  key       String   @id
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

/// 图床：通用图片二进制，编辑器通过 /api/images/:id 引用
model HostedImage {
  id        Int      @id @default(autoincrement())
  name      String
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 3D 模型分类（系统模型与导入模型共用）
model ModelCategory {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  systemModels   SystemModel[]
  importedModels ImportedModel[]
  deviceModels   DeviceModel[]
}

/// 3D 二进制文件（GLB / 图片），按 sha256 去重
model AssetFile {
  id                      Int             @id @default(autoincrement())
  name                    String
  mime                    String
  size                    Int
  sha256                  String          @unique
  data                    Bytes
  createdAt               DateTime        @default(now())
  systemModelFiles        SystemModel[]   @relation("SystemModelFile")
  systemModelThumbnails   SystemModel[]   @relation("SystemModelThumbnail")
  importedModelFiles      ImportedModel[] @relation("ImportedModelFile")
  importedModelThumbnails ImportedModel[] @relation("ImportedModelThumbnail")
  deviceModelFiles        DeviceModel[]   @relation("DeviceModelFile")
  deviceModelThumbnails   DeviceModel[]   @relation("DeviceModelThumbnail")
  sceneThumbnails         Scene[]         @relation("SceneThumbnail")
}

/// 系统模型模板
model SystemModel {
  id              Int            @id @default(autoincrement())
  key             String         @unique
  name            String
  categoryId      Int?
  kind            String
  width           Float?
  depth           Float?
  height          Float?
  fileId          Int?
  thumbnailFileId Int?
  configJson      String         @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        ModelCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  file            AssetFile?     @relation("SystemModelFile", fields: [fileId], references: [id], onDelete: Restrict)
  thumbnail       AssetFile?     @relation("SystemModelThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict)

  @@index([categoryId, kind])
}

/// 用户导入的 GLB 模型
model ImportedModel {
  id              Int            @id @default(autoincrement())
  name            String
  categoryId      Int?
  fileId          Int
  thumbnailFileId Int?
  width           Float?
  depth           Float?
  height          Float?
  configJson      String         @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        ModelCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  file            AssetFile      @relation("ImportedModelFile", fields: [fileId], references: [id], onDelete: Restrict)
  thumbnail       AssetFile?     @relation("ImportedModelThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict)

  @@index([categoryId])
}

/// 可跨场景复用的设备模型；配置与导入模型完全一致
model DeviceModel {
  id              Int            @id @default(autoincrement())
  name            String
  categoryId      Int?
  fileId          Int
  thumbnailFileId Int?
  width           Float?
  depth           Float?
  height          Float?
  configJson      String         @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        ModelCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  file            AssetFile      @relation("DeviceModelFile", fields: [fileId], references: [id], onDelete: Restrict)
  thumbnail       AssetFile?     @relation("DeviceModelThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict)

  @@index([categoryId])
}

/// LVGL HMI 屏：设备可读的卡片 JSON，sample 仅编辑器预览使用
model HmiScreen {
  id         Int      @id @default(autoincrement())
  name       String
  schemaJson String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 已发布的 HMI 页面。GET /api/hmi/publications/:id 返回设备 JSON。
model HmiPublication {
  id          Int      @id @default(autoincrement())
  description String
  schemaJson  String
  screenId    Int?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 编辑器样例数据。json 为手写；http 按 method/url/body 请求，body 可用 {{参数}}。
model HmiSampleSource {
  id         Int      @id @default(autoincrement())
  name       String
  mode       String   @default("json")
  method     String   @default("GET")
  url        String   @default("")
  body       String   @default("")
  paramsJson String   @default("{}")
  sampleJson String   @default("{}")
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 床头卡装饰图，按 sha256 去重，与三维 AssetFile 分开
model HmiFile {
  id        Int      @id @default(autoincrement())
  name      String
  mime      String
  size      Int
  sha256    String   @unique
  data      Bytes
  createdAt DateTime @default(now())
}

/// 3D 场景（整份 SceneDocument v2 快照）
model Scene {
  id              Int         @id @default(autoincrement())
  name            String
  description     String?
  sceneJson       String
  thumbnailFileId Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  thumbnail       AssetFile?  @relation("SceneThumbnail", fields: [thumbnailFileId], references: [id], onDelete: Restrict)
}
